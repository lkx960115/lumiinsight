# 复制为 .env 后填写。不要把真实 Key 提交到 Git。
# 多模型 Key 最终以「后台模型配置」为准，此处仅作本地启动兜底。

# 宿主机已有 mysql:5.7 占用 3306 时，灯鉴 MySQL 8 映射到 3307，不要连那套 5.7。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=lumiinsight
MYSQL_PASSWORD=lumiinsight
MYSQL_ROOT_PASSWORD=lumiinsight-root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=lumiinsight
MINIO_SECRET_KEY=lumiinsight-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

WORKER_BASE_URL=http://127.0.0.1:8090

JWT_SECRET=lumiinsight-dev-only-change-me-please-32b
LUMI_AES_KEY=lumiinsight-dev-aes-key-32bytes!!

# 可选：本机默认 LLM（后台未配置时的兜底，可留空）
LLM_DEFAULT_PROVIDER=zhipu
LLM_DEFAULT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_DEFAULT_MODEL=glm-4.6
# LLM_DEFAULT_API_KEY=
